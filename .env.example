# Copy to .env next to docker-compose.yml. Never commit .env.
POSTGRES_PASSWORD=change-me
SECRET_KEY=put-a-long-random-string-here
ENV=dev
# Firebase (free Spark plan). Leave empty to test with anonymous users + the dev login header.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Dev only: the admin panel opens with this login on first start. Change or remove these two lines before going live.
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=admin
