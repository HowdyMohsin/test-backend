# Copy to .env and fill in. Never commit a real .env.
APP_ENV=dev
APP_VERSION=2.1.0
ROLE=both

# Postgres (docker-compose service name "db")
DATABASE_URL=postgresql+asyncpg://qic:qic_secret@db:5432/qic

# Storage
DATA_DIR=/data
MAX_UPLOAD_MB=4096

# Auth
FIREBASE_PROJECT_ID=quick-img-convert
ADMIN_COOKIE_NAME=qic_admin_session
ADMIN_SESSION_TTL_HOURS=12
ANON_COOKIE_NAME=qic_anon
HMAC_SECRET=change-me-to-a-long-random-string

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Worker
WORKER_COUNT=4
JOB_TIMEOUT_BASE_SEC=60
JOB_TIMEOUT_PER_MB_SEC=2
JOB_TIMEOUT_PER_VIDEO_SEC=1.5
JOB_TIMEOUT_MAX_SEC=7200

# Limits
MAX_PIXELS=100000000
PDF_PAGE_CAP=50
SVG_MAX_BYTES=10485760
PSD_MAX_DIM=30000
UPLOAD_TTL_HOURS=2
DOWNLOAD_TTL_HOURS=1
CLEANUP_INTERVAL_MIN=5
DISK_MIN_FREE_MB=2048
