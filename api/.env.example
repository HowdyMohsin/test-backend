# Copy to .env and edit. Never commit .env.
ENV=dev
ROLE=both
DATABASE_URL=postgresql+asyncpg://qic:qic@localhost:5432/qic
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATA_DIR=./data
RETENTION_MINUTES=60
WORKERS=4
# Firebase (free Spark plan). Leave empty to run with anonymous users only.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
