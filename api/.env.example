# Copy to .env and edit. Never commit .env.
ENV=dev
ROLE=both
DATABASE_URL=postgresql+asyncpg://qic:qic@localhost:5432/qic
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATA_DIR=./data
RETENTION_MINUTES=60
WORKERS=4
# Browser sessions are stored in the database. Set this shorter for shared devices if needed.
USER_SESSION_DAYS=30
